{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luo.subnet/schemas/map_packet.schema.json",
  "title": "LUO Map Packet v1",
  "description": "The commodity a LUO validator round emits: an accepted, validator-scored, source-bounded legal uncertainty map for one product/question. Downstream agents consume packets, not free-form legal answers. A packet is not a legal opinion.",
  "type": "object",
  "required": [
    "schemaVersion",
    "packetId",
    "productRef",
    "question",
    "acceptedSubmission",
    "validator",
    "sourceAnchors",
    "validatorChecks",
    "map",
    "downstreamUse"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0",
      "description": "Map Packet schema version."
    },
    "packetId": {
      "type": "string",
      "pattern": "^LUO-[A-Z0-9]+-[A-Z]{2}-[0-9]{6}-[0-9]{4}$",
      "description": "Stable packet id, e.g. LUO-OUSG-XJ-202607-0001."
    },
    "productRef": {
      "type": "object",
      "required": ["productId", "name", "axis"],
      "additionalProperties": false,
      "properties": {
        "productId": { "type": "string", "description": "e.g. ondo-ousg" },
        "name": { "type": "string", "description": "e.g. Ondo OUSG" },
        "axis": { "type": "string", "description": "The single axis this packet maps, e.g. Investor Eligibility + Transfer Restrictions." },
        "asOfDate": { "type": "string", "format": "date", "description": "Text-verification date of the underlying corpus." }
      }
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "description": "The validator challenge question this packet answers."
    },
    "acceptedSubmission": {
      "type": "object",
      "required": ["minerId", "challengeId", "sRaw", "sFinal"],
      "additionalProperties": false,
      "properties": {
        "minerId": { "type": "string" },
        "challengeId": { "type": "string", "description": "Validator challenge id, e.g. LUO-OUSG-XJ-V1." },
        "minerHotkey": { "type": "string", "description": "Bittensor hotkey ss58 of the winning miner (optional in offline demo)." },
        "sRaw": { "type": "number", "minimum": 0, "maximum": 1 },
        "sFinal": { "type": "number", "minimum": 0, "maximum": 1 },
        "submittedAt": { "type": "string", "format": "date-time" }
      }
    },
    "validator": {
      "type": "object",
      "required": ["scoringVersion", "weights", "dimensionScores", "hardGate"],
      "additionalProperties": false,
      "properties": {
        "validatorHotkey": { "type": "string", "description": "Bittensor hotkey ss58 of the scoring validator (optional in offline demo)." },
        "scoringVersion": { "type": "string", "description": "e.g. v1.1" },
        "weights": {
          "type": "object",
          "required": ["citation_validity", "divergence_fidelity", "reasoning_coherence", "coverage_breadth"],
          "additionalProperties": false,
          "properties": {
            "citation_validity": { "type": "number" },
            "divergence_fidelity": { "type": "number" },
            "reasoning_coherence": { "type": "number" },
            "coverage_breadth": { "type": "number" }
          }
        },
        "dimensionScores": {
          "type": "object",
          "required": ["citation_validity", "divergence_fidelity", "reasoning_coherence", "coverage_breadth"],
          "additionalProperties": false,
          "properties": {
            "citation_validity": { "type": "number", "minimum": 0, "maximum": 1 },
            "divergence_fidelity": { "type": "number", "minimum": 0, "maximum": 1 },
            "reasoning_coherence": { "type": "number", "minimum": 0, "maximum": 1 },
            "coverage_breadth": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "hardGate": {
          "type": "object",
          "required": ["triggered", "reasons"],
          "additionalProperties": false,
          "properties": {
            "triggered": { "type": "boolean" },
            "cap": { "type": ["number", "null"] },
            "reasons": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["missing_or_invalid_source", "invalid_source_citation", "holding_mismatch"]
              }
            }
          }
        }
      }
    },
    "sourceAnchors": {
      "type": "array",
      "minItems": 1,
      "description": "The reviewed sources the accepted map is bounded by.",
      "items": {
        "type": "object",
        "required": ["sourceId", "jurisdiction", "title", "sourceUrl"],
        "additionalProperties": false,
        "properties": {
          "sourceId": { "type": "string", "description": "Corpus id, e.g. HK-SRC-01." },
          "jurisdiction": { "type": "string" },
          "title": { "type": "string" },
          "sourceUrl": { "type": "string", "format": "uri" },
          "sourceTier": { "type": "string" },
          "citationStatus": { "type": "string" },
          "asOfDate": { "type": "string", "format": "date" }
        }
      }
    },
    "validatorChecks": {
      "type": "object",
      "required": ["invalidSourceIds", "invalidSourceHits", "gateTriggered"],
      "additionalProperties": false,
      "description": "Invalid-source check record for this round. Invalid-source hits gate; they are not a weighted dimension.",
      "properties": {
        "invalidSourceIds": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Invalid-source ids included in this challenge, e.g. OUSG-SYN-01."
        },
        "invalidSourceHits": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Invalid-source ids cited by the accepted submission. Must be empty for an accepted packet."
        },
        "gateTriggered": { "type": "boolean", "description": "Must be false for an accepted packet." }
      }
    },
    "map": {
      "type": "object",
      "required": ["signals", "unresolvedGaps"],
      "additionalProperties": false,
      "properties": {
        "signals": {
          "type": "array",
          "minItems": 1,
          "description": "Per-jurisdiction claim boundaries. These are scoped evidence signals, not jurisdiction-wide legal conclusions.",
          "items": {
            "type": "object",
            "required": ["jurisdiction", "riskState", "claimBoundary", "sourceIds"],
            "additionalProperties": false,
            "properties": {
              "jurisdiction": { "type": "string", "description": "e.g. US, HK, SG, EU, PRODUCT." },
              "riskState": {
                "type": "string",
                "enum": ["settled", "restricted", "conditional", "silent", "contested"],
                "description": "Risk-state vocabulary from the LUO sample spec."
              },
              "claimBoundary": { "type": "string", "description": "What the cited sources support — and implicitly nothing more." },
              "notSupported": { "type": "string", "description": "What this signal must NOT be read to establish." },
              "sourceIds": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
            }
          }
        },
        "divergencePairs": {
          "type": "array",
          "description": "Source-backed contradictions between two jurisdiction-specific claims on the same fact.",
          "items": {
            "type": "object",
            "required": ["pairId", "factInQuestion", "sideA", "sideB", "contradictionType"],
            "additionalProperties": false,
            "properties": {
              "pairId": { "type": "string" },
              "factInQuestion": { "type": "string" },
              "sideA": { "$ref": "#/$defs/divergenceSide" },
              "sideB": { "$ref": "#/$defs/divergenceSide" },
              "contradictionType": { "type": "string", "enum": ["opposite", "more_restrictive", "silent_vs_explicit"] },
              "scopeBoundary": { "type": "string" }
            }
          }
        },
        "unresolvedGaps": {
          "type": "array",
          "description": "Open questions the packet deliberately does not answer. Downstream consumers must not fill these.",
          "items": {
            "type": "object",
            "required": ["gapId", "jurisdiction", "description"],
            "additionalProperties": false,
            "properties": {
              "gapId": { "type": "string" },
              "jurisdiction": { "type": "string" },
              "description": { "type": "string" },
              "requiredNextStep": { "type": "string", "description": "e.g. counsel review, source refresh." }
            }
          }
        }
      }
    },
    "downstreamUse": {
      "type": "object",
      "required": ["allowedTasks", "forbiddenInferences"],
      "additionalProperties": false,
      "properties": {
        "allowedTasks": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "What a consumer agent may do with this packet, e.g. market-entry sequencing, counsel-briefing prep, risk flagging."
        },
        "forbiddenInferences": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "Inferences the packet explicitly forbids, e.g. treating silence as permission, treating a conditional framework as an available route."
        }
      }
    }
  },
  "$defs": {
    "divergenceSide": {
      "type": "object",
      "required": ["jurisdiction", "position", "sourceIds"],
      "additionalProperties": false,
      "properties": {
        "jurisdiction": { "type": "string" },
        "claimId": { "type": "string" },
        "position": { "type": "string" },
        "sourceIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
